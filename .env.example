# --- Modelo de linguagem (Ollama) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1600
OLLAMA_TIMEOUT=600
# Acrescenta /no_think aos prompts (qwen3 pula o raciocínio separado).
OLLAMA_NO_THINK=true
# true mostra no log cada passo dos agentes do CrewAI.
CREW_VERBOSE=false

# --- Recuperação ---
EMBEDDING_MODEL=BAAI/bge-m3
# Deixe vazio para desligar o reranker. Ex.: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=
RAG_LIMIT=5
# Orçamento do contexto em caracteres (~4 por token; precisa caber em OLLAMA_NUM_CTX).
CONTEXT_CHARS=14000

# --- Ingestão ---
DATA_DIR=data
# Pasta local com PDFs. Se o document_id existir nela, o Garage não é consultado.
DOCS_FOLDER=processo_RAG
# OCR de páginas sem texto (exige Tesseract instalado na imagem).
OCR_ENABLED=false
# false desliga os agentes extratores; ficam só os extratores por regras.
EXTRACAO_LLM=true

# --- Garage (S3 compatível) ---
GARAGE_ENDPOINT=
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=

# --- API ---
FRONTEND_URL=http://localhost:3000
# Com valor definido, as rotas /api exigem o cabeçalho X-API-Key.
API_KEY=
